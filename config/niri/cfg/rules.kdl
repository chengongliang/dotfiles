    /* Apps: blur them all without xray for a better look */
    window-rule {
      background-effect {
        blur true
        xray false
      }
    }

    /* Noctalia：layer 命名空间在 5.x（Rust 重写版）后改为不带输出后缀，
       如 noctalia-bar-default、noctalia-attached-panel（旧版为
       noctalia-<role>-<output>，如 noctalia-background-eDP-1）。
       新版自身会通过 ext-background-effect-v1 协议请求模糊（niri 26.04 已支持），
       这里只为 bar / attached-panel 配兜底规则；
       注意不要匹配 noctalia-panel-click-shield（全屏透明点击层，blur 开销大）。 */
    layer-rule {
        match namespace="^noctalia-(bar-.*|attached-panel)$"
        background-effect {
            blur true
            xray false
        }
    }

    window-rule {
        match app-id="Loupe"

        popups {
            // Matches the default libadwaita pop-up corner radius.
            geometry-corner-radius 10

            // Note: it'll look better to set background opacity
            // through your GTK theme CSS and not here.
            // This is just an example that makes it look obvious.
            opacity 0.5

            background-effect {
                blur true
            }
        }
    }

    // Enable blur behind the Alacritty terminal.
    window-rule {
        match app-id="(alacritty|kitty|ghostty|nautilus|spotify)"

        background-effect {
            blur true
        }
    }

    // Enable blur behind the fuzzel launcher.
    layer-rule {
        match namespace="^launcher$"

        background-effect {
            blur true
        }
    }

    window-rule {
        geometry-corner-radius 10 // Set every window radius to 10
        clip-to-geometry true
        // 对，niri绘制s
        draw-border-with-background false
        // 新窗口默认不最大化
        open-maximized false
        // 新窗口默认平铺，而非浮动
        //open-floating false

        // 全局默认宽度设置为屏幕宽度的 80%
        default-column-width { proportion 0.8; }
        default-window-height {
        	proportion 1.0;
        }
    }

    // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    // Steam 大屏模式 (Big Picture Mode / 大屏幕模式): 自动全屏，不浮动（覆盖上面的浮动规则）
    window-rule {
        match app-id=r#"^(steam|steamwebhelper)$" title=r#"(大屏幕|[Bb]ig [Pp]icture)"#
        open-floating false
        open-fullscreen true
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }


    // 疯狂的悬浮匹配
    window-rule {
    	match app-id="(kitty|blueberry|guifetch|pavucontrol|pulseaudio|nm-connection-editor|plasma|kcm_|bluedevilwizard|Welcome|illogical-impulse|Zotero|fuzzel)"
    	open-floating true
    }
    // 宽度1.0
    // window-rule {
    // 	match app-id="(zen)"
    // 	default-column-width {
    // 		proportion 1.0
    // 	}
    // }
    // Dropdown terminal 改用 kitty quick-access-terminal（layer-shell 面板），见 keybinds.kdl 的 Mod+Grave
    // ghostty 默认宽度见文末 0.5 规则

    // 宽度0.6
    window-rule {
    	match app-id="systemsettings"
    	default-column-width {
    		proportion 0.6
    	}
    }
    //宽度0.5
    window-rule {
        match app-id="(cc-switch|goland|rustover|google-chrome|clion|CLion|sparkle|kitty|foot|Alacritty)"

        default-column-width {
    		proportion 0.5;
    	}
    }
    // 宽度0.3
    window-rule {
     	match app-id="karing"
        default-column-width {
        	proportion 0.3
        }
    }
    //高度0.5（含 kitty；原先单独 0.8 已被本规则覆盖，已删除）
    window-rule {
        match app-id="(goland|rustover|clion|CLion|sparkle|kitty|foot|Alacritty)"

        // Half of the screen high.
        default-window-height {
    		proportion 0.5;
    	}
    }
    // 微软浏览器
    window-rule {
      match app-id="microsoft-edge" title=r#"^$"#
      open-floating true
    }
    // vscode悬浮窗专享
    window-rule {
        match app-id="code" title="^Visual Studio Code$"
        open-floating true
    }
    // QQ专享
    window-rule {
        match app-id="QQ" title="^QQ$"
        default-column-width {
            proportion 0.2;
        }
    }
    window-rule {
        match app-id="QQ"
        exclude title="^QQ$"
        default-column-width {
            proportion 0.8;
        }
    }
    // telegram专享
    window-rule {
      match app-id="org.telegram.desktop" title="Media viewer"
      open-floating true
        default-window-height {
                    proportion 0.5;
            }
        // 80% of the screen wide.
        default-column-width {
            proportion 0.5;
        }
    }
    window-rule {
      match app-id="org.telegram.desktop"
      exclude title="Telegram"
      open-floating true
        default-window-height {
                    proportion 0.75;
            }
        // 80% of the screen wide.
        default-column-width {
                    proportion 0.75;
            }
    }
    window-rule {
    	match title="^[Pp]icture[-\\s]?[Ii]n[-\\s]?[Pp]icture.*$"
    	open-floating true
    	default-column-width {
    		fixed 400
    	}
    }

    // EasyConnect: 固定平铺尺寸 817x580
    window-rule {
    	match app-id="EasyConnect"
    	default-column-width {
    		fixed 800
    	}
    	default-window-height {
    		fixed 500
    	}
    }

    // 钉钉: 固定浮动尺寸
    window-rule {
    	match app-id="dingtalk"
        open-floating true
    	default-column-width {
    		fixed 1280
    	}
    	default-window-height {
    		fixed 900
    	}
    }

    // 钉钉透明覆盖层 / toast 载体窗口（title 与 app-id 同名）：
    // 钉钉按 X11 全局坐标定位它，在 niri 下会叠在主窗口上，全局 blur 又把
    // 它渲染成毛玻璃"蒙板"。这里关掉 blur 恢复完全透明（视觉上只剩 toast
    // 文字小块）、不抢焦点。
    // 自动关闭原本由 dynamic-float.py 处理，2026-09-28 起脚本已停用
    // （排查 @人候选弹窗秒关问题，结论：与脚本无关，见该脚本 RULES 注释）。
    window-rule {
        match app-id=r#"^com\.alibabainc\.dingtalk$"# title=r#"^com\.alibabainc\.dingtalk$"#
        open-floating true
        // open-focused false 属原始配置；2026-09-28 实验曾怀疑它导致 @人
        // 弹窗失焦被关，实测放开焦点后弹窗依然秒关（无关），已恢复原设置。
        open-focused false
        background-effect {
            blur false
        }
    }

    // 【实验记录 2026-09-28】钉钉 X11 弹窗（Form，如 @人候选）被 niri/satellite
    // 在 map 时从钉钉请求的几何改成浮动默认，导致钉钉 hide（一闪而退）。
    // 实验结论：
    //   - 不设规则：钉钉 map 240x98+1727+553 → 被改成 240x900+1280+0 → hide
    //   - fixed 98：尺寸对了但位置仍被换成工作区原点 → hide
    //   - fixed 372：与钉钉 map 请求一致，位置仍被换（待验证是否仍 hide）
    // 注意：niri 无法按尺寸匹配，该规则会命中所有名为 Form 的钉钉弹窗。
    // 排查期间临时停用，待确定方案后再启用。
    //window-rule {
    //    match app-id=r#"^com\.alibabainc\.dingtalk$"# title=r#"^Form$"#
    //    open-floating true
    //    default-column-width { fixed 240; }
    //    default-window-height { fixed 372; }
    //}

    // 微信: 固定浮动尺寸
    window-rule {
    	match app-id="wechat"
        open-floating true
    	default-column-width {
    		fixed 1280
    	}
    	default-window-height {
    		fixed 900
    	}
    }

    // alacritty 宽度已在上方 0.5 组；此处仅保留其余应用
    // brave 与 helium 宽度已调换：brave 回落到默认宽度 1.0，helium 设为 0.5
    window-rule {
        match app-id="(firefox|wezterm|thunar|helium)"
        default-column-width { proportion 0.5; }
    }
    // Zen: Bitwarden 密码管理器弹窗
    window-rule {
        match app-id="zen" title=r#".*[Bb]itwarden.*"#
        default-column-width { proportion 0.3; }
        max-width 500
    }
    // Zen 授权/Bitwarden 弹窗的浮动改由 scripts/dynamic-float.py 动态处理：
    // Firefox 系窗口打开后才设置标题，window-rule 的 open-floating 按 title 匹配不到（见 niri FAQ）
    window-rule {
        match app-id="zen"
        exclude title=r#".*[Bb]itwarden.*"#
        default-column-width { proportion 1.0; }
    }
    // ghostty 宽度 0.5
    window-rule {
        match app-id="ghostty"
        default-column-width { proportion 0.5; }
    }
    // Codex: 当前应用宽度 1.0
    window-rule {
        match app-id="codex"
        default-column-width { proportion 1.0; }
    }
    // Paseo: 服务启动时默认 100% 窗口宽度
    window-rule {
        match app-id="Paseo"
        default-column-width { proportion 1.0; }
        // 合成器层面半透明（opacity 与全局 background-effect blur 叠加成毛玻璃）
        // 0.0 全透明 / 1.0 不透明，Paseo 以长文阅读为主，取 0.85
        opacity 0.85
    }
    // Pebrel: 新窗口默认 100% 宽度
    window-rule {
        match app-id="pebrel"
        default-column-width { proportion 1.0; }
    }

    // magpie quick panel（点托盘图标弹出的面板）放在右下角。
    // magpie 自带的 niri 集成（internal/omarchy.NiriPanel）假设 bar 在顶部，
    // 面板每次打开都会被它搬到“工作区顶部往下 6px”（magpie#1670），覆盖
    // 这里的定位。因此要让 magpie 不接管面板位置：
    //   1. patches/apply-magpie-no-niri-panel.sh：改二进制里的 NIRI_SOCKET，
    //      对所有启动方式生效（magpie 自更新/升级后会失效，需重跑）
    //   2. ~/.config/autostart/magpie.desktop：启动时去掉 NIRI_SOCKET（兜底）
    window-rule {
        match app-id="magpie" title="magpie panel"
        open-floating true
        default-floating-position x=6 y=6 relative-to="bottom-right"
    }

    // DeepSeek 快速对话浮窗（Mod+CTRL+A → scripts/deepseek-popup.sh）。
    // Helium/Chromium 的 --app 模式会给出形如 chrome-<host>__-<Profile> 的独立
    // app-id（后缀随 profile 目录名变化），所以只匹配 host 前缀。
    window-rule {
        match app-id=r#"^chrome-chat\.deepseek\.com"#
        open-floating true
        default-column-width { fixed 480; }
        default-window-height { fixed 720; }

        // 定位到当前输出右下角。niri 会扣掉状态栏的 exclusive zone，
        // 所以这里的 24 就是贴边的留白。
        default-floating-position x=24 y=24 relative-to="bottom-right"

        // 弹窗观感：圆角 + 无边框 + 柔和阴影，去掉平铺窗口那个聚焦环
        geometry-corner-radius 12
        clip-to-geometry true
        border { off; }
        focus-ring { off; }
        shadow {
            on;
            softness 30;
            spread 5;
            color "#00000060";
        }
    }
