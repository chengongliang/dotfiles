// ────────────── Input Configuration ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input

input {
    keyboard {
        xkb {
            //If you want to overwrite your keyboard layout,
            // uncomment the line below and change the layout accordingly.
            //layout "us" // Use the American keyboard layout
        }
        numlock // Enable numlock on startup
    }

    touchpad {
        tap // Enable tap-to-click
        natural-scroll // Enable natural (macOS-style) scrolling
    }

    mouse {
        // If you want to disable Mouse Acceleration,
        // uncomment the lines below.
        accel-profile "flat"
        //accel-speed 0.0
    }

    // ── 完整恢复焦点跟随鼠标（含自动滚动视图）[2026-09-15] ──────────────
    // 保留全部原有行为：鼠标移到部分可见的窗口时，也会自动滚动视图并聚焦过去。
    //
    // 已知副作用（Wayland + XWayland 应用如钉钉）：焦点随鼠标频繁切换时，键盘的
    // key-release 事件可能丢失，按键会被判定为「一直按着」，Xwayland 便以
    // repeat-rate（默认 25/s）持续发送重复事件 →「无限粘贴」「按键停不下来」
    // 直至应用卡死。幽灵修饰键（尤其 Super）粘连是同一机制，日常按 Mod 组合键
    // 就会偶发（2026-10-15 实测 20 分钟内出现 2 次，非钉钉场景也会发生）。
    //
    // [2026-10-15] 钉钉无限粘贴复发实测：47 秒 × 25 条/秒的 Xwayland 日志
    // "Key repeat discarded"（经 xwayland-satellite 转发），据此加装了
    // stuck-key-guard 自动熔断（systemd 用户服务）：监测日志风暴（2s 内 ≥15 条）
    // 与持续按住 ≥20s 的幽灵键，自动释放卡键，无需人工反应。
    // 若守护未及处理，依次手动尝试：
    //   1) terminal 里运行  fix-stuck-keys     （释放卡住的修饰键；--release-all 全清）
    //   2) 按一下卡住的那个物理键（物理 release 事件会重置 X11 状态）
    //   3) 切换一次窗口焦点（Mod + 方向键）
    //   4) 应用已卡死就重启应用
    focus-follows-mouse // Automatically focus windows under the mouse pointer

    workspace-auto-back-and-forth // Enable workspace back & forth switching
}
